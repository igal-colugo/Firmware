# Custom VTOL Mixer - Front: Pitch+Roll, Rear: Pitch+Yaw

# ===== Front Motors (0,2) - Pitch + Roll Only =====

# Motor 0 - Front Right (Pitch- Roll-)
M: 2
O:      10000  10000      0 -10000  10000
S: 1 0  10000  10000      0 -10000  10000  # Roll (negative)
S: 1 1  -8000  -8000      0 -10000  10000  # Pitch (negative)

# Motor 2 - Front Left (Pitch- Roll+)
M: 2
O:      10000  10000      0 -10000  10000
S: 1 0  -10000  -10000      0 -10000  10000  # Roll (positive)
S: 1 1  -8000  -8000      0 -10000  10000   # Pitch (negative)

# ===== Rear Motors (1,3) - Pitch + Yaw Only =====

# Motor 1 - Rear Left (Pitch+ Yaw+)
M: 2
O:      10000  10000      0 -10000  10000
S: 1 1  8000   8000       0 -10000  10000   # Pitch (positive)
S: 1 2  10000  10000      0 -10000  10000   # Yaw (positive)

# Motor 3 - Rear Right (Pitch+ Yaw-)
M: 2
O:      10000  10000      0 -10000  10000
S: 1 1  8000   8000       0 -10000  10000   # Pitch (positive)
S: 1 2  -10000  -10000      0 -10000  10000  # Yaw (negative)

# ===== Fixed Wing Control Surfaces =====

# Right elevon
M: 2
O:      10000  10000      0 -10000  10000
S: 1 0   6000   6000      0 -10000  10000  # Roll
S: 1 1   6000   6000      0 -10000  10000  # Pitch

# Left elevon
M: 2
O:      10000  10000      0 -10000  10000
S: 1 0  -6000  -6000      0 -10000  10000  # Roll (inverted)
S: 1 1   6000   6000      0 -10000  10000  # Pitch

# Rudder
M: 1
O:      10000  10000      0 -10000  10000
S: 1 2  10000  10000      0 -10000  10000  # Yaw
